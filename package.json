{
  "name": "qbot",
  "version": "7.4.0",
  "description": "The most advanced Discord to Roblox ranking bot available, open source and free, without any branding.",
  "main": "dist/main.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "prisma generate --schema ./src/database/schema.prisma && tsc --outDir dist && mkdir -p dist/resources && cp -r src/resources/* dist/resources/",
    "dev": "nodemon src/main.ts --ignore ./src/resources/commands.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "resetSlashCmds": "echo [] > src/resources/commands.json",
    "update": "git fetch && git reset --hard origin/master && git pull"
  },
  "author": "LengoLabs",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/lodash": "^4.14.195",
    "@types/ms": "^0.7.34",
    "@types/node": "^17.0.4",
    "nodemon": "^3.0.0",
    "prisma": "^5.22.0",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.6.0",
    "bloxy": "5.8.0",
    "discord.js": "12.5.3",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "figlet": "^1.6.0",
    "got": "^11.8.6",
    "lexure": "^0.17.0",
    "lodash": "^4.17.21",
    "ms": "^2.1.3"
  }
}
